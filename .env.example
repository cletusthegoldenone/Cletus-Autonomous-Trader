# ============================================================================
# CLETUS AUTONOMOUS TRADER - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local for development
# For production, use Vercel Secrets (see DEPLOYMENT_SECRETS_GUIDE.md)
#
# IMPORTANT: Never commit actual values to Git
# .env.local is in .gitignore and will not be committed
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=production
VERCEL_ENV=production

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Format: postgresql://user:password@host:port/database
# Example: postgresql://cletus:password123@db.example.com:5432/cletus_trader
DATABASE_URL=postgresql://user:password@localhost:5432/cletus

# Connection pool size (default: 20)
DATABASE_POOL_SIZE=20

# Enable SSL for database connections (recommended for production)
DATABASE_SSL=true

# Log all database queries (development only, disable in production)
DATABASE_LOG_QUERIES=false

# ============================================================================
# AUTHENTICATION & ADMIN ACCESS
# ============================================================================
# Session secret for authentication (generate a long random string)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-long-random-secret-here

# Admin PIN for emergency access (4-6 digits)
ADMIN_PIN=123456

# Admin recovery code (backup access if PIN is lost)
ADMIN_RECOVERY_CODE=BACKUP-CODE-HERE

# ============================================================================
# EXCLUSIVE ADMIN WALLET (Single Wallet Access)
# ============================================================================
# This is YOUR personal wallet address (public key)
# Only this wallet can access the Cletus dashboard and execute trades
# Format: Solana public key (base58 encoded)
ADMIN_WALLET_ADDRESS=9xQeKq6isj8Xu26Ku2b3FqxZsEaq5XfVhJ5dNon9Mop7

# ============================================================================
# TRADE FEES & WALLET
# ============================================================================
# Percentage fee deducted from each trade on close (e.g. 1.0 = 1%)
TRADE_FEE_PERCENT=1.0

# Wallet address where trade fees are collected (owner/treasury wallet)
FEE_WALLET_ADDRESS=9xQeKq6isj8Xu26Ku2b3FqxZsEaq5XfVhJ5dNon9Mop7

# ============================================================================
# SOLANA BLOCKCHAIN & RPC CONFIGURATION
# ============================================================================
# Primary RPC Provider - Helius (Strongly recommended for production)
# Get your free API key at: https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Optional: Custom Helius RPC URL (if not using default)
# Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Fallback RPC URL (used if Helius fails)
# This should be a reliable, public RPC endpoint
RPC_URL=https://api.mainnet-beta.solana.com

# Solana network (mainnet-beta for production)
SOLANA_NETWORK=mainnet-beta

# Priority fee in lamports (for transaction priority)
# Higher = faster execution, lower = slower but cheaper
# The self-healing engine will escalate this automatically on RPC failures.
PRIORITY_FEE_LAMPORTS=100000

# ============================================================================
# JUPITER AGGREGATOR INTEGRATION
# ============================================================================
# Jupiter API Key for swap execution (paid tier — higher rate limits, priority routing)
# Get your key at: https://portal.jup.ag
# Without a key the free public API (quote-api.jup.ag/v6) is used as fallback.
JUPITER_API_KEY=your_jupiter_api_key_here

# ============================================================================
# GEMINI AI INTEGRATION
# ============================================================================
# Google Gemini API Key for AI Brain functionality
# Get your key at: https://makersuite.google.com
# This enables the AI question-answering feature
GEMINI_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini Model (default: gemini-2.5-flash for latest)
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# RUGCHECK.XYZ INTEGRATION
# ============================================================================
# API key for rugcheck.xyz — used by the Dev Wallet Inspector AND the pre-trade
# security audit before every live trade execution.
# Get your key at: https://rugcheck.xyz (dashboard → API Keys)
# Without this key the audit still runs using on-chain heuristics only.
RUGCHECK_API_KEY=your_rugcheck_api_key_here

# Maximum acceptable rugcheck risk score to allow a trade (0–100, default 69)
# Tokens scoring above this are blocked automatically.
MAX_AUDIT_RISK_SCORE=69

# ============================================================================
# TRADING PARAMETERS & SIGNALS
# ============================================================================
# Market cap filters (in USD)
MIN_MARKET_CAP=25000
MAX_MARKET_CAP=1000000000

# Minimum 24h trading volume (in USD)
MIN_VOLUME_USD=5000

# Slippage tolerance (0.05 = 5%)
SLIPPAGE_TOLERANCE=0.05

# Maximum position size per trade (in USD)
MAX_POSITION_SIZE_USD=5000

# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=5

# ============================================================================
# SEC COMPLIANCE THRESHOLDS
# ============================================================================
# Maximum fraction of a token's 24h volume a single trade may represent.
# Prevents market manipulation via position concentration (Exchange Act § 9).
SEC_MAX_VOLUME_SHARE=0.05

# Maximum fraction of a token's pool liquidity a single trade may represent.
# Prevents liquidity manipulation (Exchange Act § 9 / Rule 10b-5).
SEC_MAX_LIQUIDITY_SHARE=0.10

# Look-back window (minutes) for wash-trading detection.
# If a token was both bought and sold within this window, re-entry is blocked
# as a potential wash-trade pattern (Exchange Act § 9(a)(1)).
SEC_WASH_TRADE_WINDOW_MINUTES=60

# Maximum number of trades across all tokens in any 5-minute window.
# Prevents creating an artificial appearance of market activity (Exchange Act § 9).
SEC_MAX_TRADES_PER_5MIN=8

# Approximate SOL price in USD used for position-size calculations when no
# live price is available. Update periodically or set to a conservative value.
SEC_DEFAULT_SOL_PRICE_USD=180


# Minimum composite score to enter a trade (0.0 to 1.0)
MIN_COMPOSITE_SCORE=0.65

# Signal weights used by the pattern memory engine (should sum to 1.0).
# These are the INITIAL weights — the self-learning engine adjusts them
# over time based on trade outcomes (winning signals get amplified, losing
# signals get dampened).
SIGNAL_VOLUME_SPIKE_WEIGHT=0.15
SIGNAL_MOMENTUM_WEIGHT=0.15
SIGNAL_BREAKOUT_WEIGHT=0.12
SIGNAL_RSI_WEIGHT=0.12
SIGNAL_MACD_WEIGHT=0.12
SIGNAL_HOLDER_GROWTH_WEIGHT=0.15
SIGNAL_LIQUIDITY_BUILD_WEIGHT=0.10
SIGNAL_SOCIAL_WEIGHT=0.09

# ============================================================================
# OPERATING SCHEDULE
# ============================================================================
# Enable 24/7 trading (true/false)
ENABLE_24_7_TRADING=false

# Trading start time (HH:MM format, 24-hour)
TRADING_START_TIME=09:00

# Trading end time (HH:MM format, 24-hour)
TRADING_END_TIME=17:00

# Trading timezone (e.g., America/New_York, Europe/London)
TRADING_TIMEZONE=America/New_York

# Pause trading on weekends
PAUSE_ON_WEEKENDS=true

# ============================================================================
# PROFIT & LOSS MANAGEMENT
# ============================================================================
# Stop loss percentage (exit if loss exceeds this)
STOP_LOSS_PERCENTAGE=10.0

# Take profit percentage (exit if profit reaches this)
TAKE_PROFIT_PERCENTAGE=25.0

# Enable trailing stops (follow price upward and exit on reversal)
ENABLE_TRAILING_STOP=true

# Trailing stop percentage (5.0 = 5% below peak)
TRAILING_STOP_PERCENTAGE=5.0

# ============================================================================
# DAILY/WEEKLY/MONTHLY TARGETS
# ============================================================================
# Daily profit target (stop trading when reached)
DAILY_PNL_TARGET=5000

# Daily loss limit (pause trading if exceeded)
DAILY_LOSS_LIMIT=-2000

# Weekly profit target
WEEKLY_PNL_TARGET=30000

# Weekly loss limit
WEEKLY_LOSS_LIMIT=-10000

# Monthly profit target
MONTHLY_PNL_TARGET=100000

# Monthly loss limit
MONTHLY_LOSS_LIMIT=-30000

# ============================================================================
# RISK MANAGEMENT
# ============================================================================
# Risk per trade as % of account (Kelly-inspired)
RISK_PER_TRADE_PERCENTAGE=2.0

# Maximum total exposure across all open positions
MAX_TOTAL_EXPOSURE_PERCENTAGE=25.0

# Maximum drawdown before pausing (15.0 = 15%)
MAX_DRAWDOWN_PERCENTAGE=15.0

# Enable recovery mode (reduced aggression after losses)
ENABLE_RECOVERY_MODE=true

# Recovery mode aggression multiplier (0.5 = 50% intensity)
RECOVERY_MODE_AGGRESSION_MULTIPLIER=0.5

# ============================================================================
# MARKET FILTERS
# ============================================================================
# Minimum token age in hours (skip new tokens)
MIN_TOKEN_AGE_HOURS=1

# Maximum holder concentration (0.30 = 30%, rug risk)
MAX_HOLDER_CONCENTRATION=0.30

# Maximum hourly price movement (prevent pump-and-dump)
MAX_HOURLY_PRICE_MOVEMENT=50.0

# Require verified liquidity lock
REQUIRE_LIQUIDITY_LOCK=true

# ============================================================================
# OPTIONAL: RATE LIMITING & CACHING (Production)
# ============================================================================
# Redis URL for rate limiting and caching (optional)
# Format: redis://user:password@host:port
# REDIS_URL=redis://localhost:6379

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log all signals (verbose, development only)
LOG_ALL_SIGNALS=false

# Log all position changes
LOG_POSITION_CHANGES=true

# Enable simulation mode (calculate trades, don't execute)
ENABLE_SIMULATION_MODE=false

# Enable dry-run mode (log trades but don't execute)
ENABLE_DRY_RUN=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable live trading (false = simulation/dry-run only)
# MUST be set to true AND TRADING_WALLET_PRIVATE_KEY must be configured for
# real swaps to execute. Without the private key the system records positions
# in dry-run mode regardless of this flag.
ENABLE_LIVE_TRADING=true

# Enable AI Brain (Gemini integration)
ENABLE_AI_BRAIN=true

# Enable kill switch
ENABLE_KILL_SWITCH=true

# ============================================================================
# STAKING & TOKEN CONFIGURATION (Coming Soon)
# ============================================================================
# Cletus token contract address (on Solana)
# CLETUS_TOKEN_ADDRESS=xxx

# Staking program ID
# STAKING_PROGRAM_ID=xxx

# ============================================================================
# MONITORING & ALERTS (Optional)
# ============================================================================
# Discord webhook for alerts (optional)
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/xxx

# Email for alerts (optional)
# ALERT_EMAIL=your-email@example.com

# Slack webhook for alerts (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ============================================================================
# SECURITY NOTES
# ============================================================================
# CRITICAL: Keep these secrets safe!
#
# DO:
# ✅ Use strong, random values for secrets
# ✅ Store sensitive values ONLY in Vercel Secrets (production)
# ✅ Use a hardware wallet for ADMIN_WALLET_ADDRESS
# ✅ Rotate API keys every 6 months
# ✅ Monitor unusual activity in logs
#
# DON'T:
# ❌ Never commit .env.local to Git
# ❌ Never share secrets via Slack/email
# ❌ Never hardcode secrets in source code
# ❌ Never log secrets to console
# ❌ Never expose ADMIN_WALLET_ADDRESS if possible
#
# See SECURITY.md for complete security guidelines
# See DEPLOYMENT_SECRETS_GUIDE.md for production deployment
#
# ============================================================================
