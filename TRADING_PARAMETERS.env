# ============================================================================
# CLETUS TRADING PARAMETERS & CLIENT CONFIGURATION
# ============================================================================
# This file contains all configurable parameters for Cletus trading behavior
# Clients can customize these based on their risk tolerance and availability
# ============================================================================

# ============================================================================
# OPERATING SCHEDULE (When Cletus Trades)
# ============================================================================

# Enable/disable 24/7 trading
ENABLE_24_7_TRADING=false

# If 24/7 trading is disabled, set trading windows
# Format: HH:MM (24-hour format, UTC)
TRADING_START_TIME=09:00
TRADING_END_TIME=17:00

# Trading days (0=Monday, 6=Sunday)
TRADING_DAYS=0,1,2,3,4

# Timezone for schedule interpretation (e.g., America/New_York, Europe/London, Asia/Tokyo)
TRADING_TIMEZONE=America/New_York

# Pause trading on weekends
PAUSE_ON_WEEKENDS=true

# Pause trading on major holidays
PAUSE_ON_HOLIDAYS=true

# ============================================================================
# AGGRESSION LEVEL (Trading Strategy Intensity)
# ============================================================================
# Values: CONSERVATIVE (1), MODERATE (2), AGGRESSIVE (3), MAXIMUM (4)
# This parameter scales multiple trading behaviors
AGGRESSION_LEVEL=MODERATE

# ============================================================================
# AGGRESSION LEVEL SCALING - CONSERVATIVE (1)
# ============================================================================
# For risk-averse traders who want slow, steady growth
CONSERVATIVE_MIN_COMPOSITE_SCORE=0.75
CONSERVATIVE_MAX_POSITION_SIZE_USD=1000
CONSERVATIVE_MAX_OPEN_POSITIONS=2
CONSERVATIVE_SLIPPAGE_TOLERANCE=0.02
CONSERVATIVE_PRIORITY_FEE_LAMPORTS=50000
CONSERVATIVE_TRADE_FREQUENCY_SECONDS=300
CONSERVATIVE_MIN_VOLUME_USD=10000
CONSERVATIVE_HOLD_TIME_MINUTES=120

# ============================================================================
# AGGRESSION LEVEL SCALING - MODERATE (2)
# ============================================================================
# Balanced approach: decent returns with controlled risk
MODERATE_MIN_COMPOSITE_SCORE=0.65
MODERATE_MAX_POSITION_SIZE_USD=5000
MODERATE_MAX_OPEN_POSITIONS=5
MODERATE_SLIPPAGE_TOLERANCE=0.05
MODERATE_PRIORITY_FEE_LAMPORTS=100000
MODERATE_TRADE_FREQUENCY_SECONDS=120
MODERATE_MIN_VOLUME_USD=5000
MODERATE_HOLD_TIME_MINUTES=60

# ============================================================================
# AGGRESSION LEVEL SCALING - AGGRESSIVE (3)
# ============================================================================
# High-risk, high-reward: chases alpha with larger positions
AGGRESSIVE_MIN_COMPOSITE_SCORE=0.55
AGGRESSIVE_MAX_POSITION_SIZE_USD=15000
AGGRESSIVE_MAX_OPEN_POSITIONS=10
AGGRESSIVE_SLIPPAGE_TOLERANCE=0.10
AGGRESSIVE_PRIORITY_FEE_LAMPORTS=200000
AGGRESSIVE_TRADE_FREQUENCY_SECONDS=60
AGGRESSIVE_MIN_VOLUME_USD=2000
AGGRESSIVE_HOLD_TIME_MINUTES=30

# ============================================================================
# AGGRESSION LEVEL SCALING - MAXIMUM (4)
# ============================================================================
# Extreme risk: rapid-fire trades, maximum leverage, bleeding edge
MAXIMUM_MIN_COMPOSITE_SCORE=0.45
MAXIMUM_MAX_POSITION_SIZE_USD=50000
MAXIMUM_MAX_OPEN_POSITIONS=20
MAXIMUM_SLIPPAGE_TOLERANCE=0.20
MAXIMUM_PRIORITY_FEE_LAMPORTS=500000
MAXIMUM_TRADE_FREQUENCY_SECONDS=30
MAXIMUM_MIN_VOLUME_USD=1000
MAXIMUM_HOLD_TIME_MINUTES=10

# ============================================================================
# PnL (PROFIT & LOSS) PARAMETERS
# ============================================================================

# STOP LOSS - Exit if loss exceeds this percentage
STOP_LOSS_PERCENTAGE=10.0

# TAKE PROFIT - Exit if profit reaches this percentage
TAKE_PROFIT_PERCENTAGE=25.0

# BREAK EVEN STOP - Move stop loss to entry price after this profit %
BREAK_EVEN_TRIGGER_PERCENTAGE=5.0

# TRAILING STOP - Follow price upward and exit on reversal
ENABLE_TRAILING_STOP=true
TRAILING_STOP_PERCENTAGE=5.0

# ============================================================================
# CUMULATIVE PnL TARGETS & SCALING
# ============================================================================
# As Cletus accumulates profit, position sizing scales up automatically

# Daily PnL Target - Stop trading once daily target is hit
DAILY_PNL_TARGET=5000

# Daily PnL Limit - Maximum daily loss before auto-pause
DAILY_LOSS_LIMIT=-2000

# Weekly PnL Target
WEEKLY_PNL_TARGET=30000

# Weekly PnL Limit
WEEKLY_LOSS_LIMIT=-10000

# Monthly PnL Target
MONTHLY_PNL_TARGET=100000

# Monthly PnL Limit
MONTHLY_LOSS_LIMIT=-30000

# ============================================================================
# POSITION SIZING TIERS (Based on Cumulative PnL)
# ============================================================================
# Clip size multipliers increase as Cletus accumulates profits
# This allows the system to scale responsibly without human intervention

# Tier 1: Seed phase ($0 - $10k cumulative PnL)
TIER_1_PNL_THRESHOLD=0
TIER_1_PNL_CEILING=10000
TIER_1_CLIP_MULTIPLIER=1.0
TIER_1_MAX_POSITION_SIZE_FACTOR=1.0

# Tier 2: Growth phase ($10k - $20k)
TIER_2_PNL_THRESHOLD=10000
TIER_2_PNL_CEILING=20000
TIER_2_CLIP_MULTIPLIER=1.5
TIER_2_MAX_POSITION_SIZE_FACTOR=1.3

# Tier 3: Scale phase ($20k - $40k)
TIER_3_PNL_THRESHOLD=20000
TIER_3_PNL_CEILING=40000
TIER_3_CLIP_MULTIPLIER=2.0
TIER_3_MAX_POSITION_SIZE_FACTOR=1.6

# Tier 4: Cruising phase ($40k - $60k)
TIER_4_PNL_THRESHOLD=40000
TIER_4_PNL_CEILING=60000
TIER_4_CLIP_MULTIPLIER=2.5
TIER_4_MAX_POSITION_SIZE_FACTOR=2.0

# Tier 5: Profit maximization ($60k+)
TIER_5_PNL_THRESHOLD=60000
TIER_5_CLIP_MULTIPLIER=3.0
TIER_5_MAX_POSITION_SIZE_FACTOR=2.5

# ============================================================================
# DRAWDOWN & RECOVERY MANAGEMENT
# ============================================================================

# Maximum drawdown from all-time high before pausing
MAX_DRAWDOWN_PERCENTAGE=15.0

# Enable automatic recovery mode (reduced aggression after losses)
ENABLE_RECOVERY_MODE=true

# Aggression reduction in recovery mode (0.0 to 1.0)
RECOVERY_MODE_AGGRESSION_MULTIPLIER=0.5

# Number of consecutive winning trades to exit recovery mode
RECOVERY_MODE_EXIT_WINS=5

# ============================================================================
# SIGNAL WEIGHTING & SCORING
# ============================================================================
# Dynamically adjust how much each signal matters

# Enable dynamic signal weighting (learns from wins/losses)
ENABLE_DYNAMIC_SIGNAL_WEIGHTING=true

# Initial signal weights (sum should equal 1.0)
SIGNAL_VOLUME_SPIKE_WEIGHT=0.15
SIGNAL_MOMENTUM_WEIGHT=0.15
SIGNAL_BREAKOUT_WEIGHT=0.12
SIGNAL_VELOCITY_SURGE_WEIGHT=0.12
SIGNAL_MICRO_CAP_HEAT_WEIGHT=0.15
SIGNAL_NANO_CAP_SPIKE_WEIGHT=0.12
SIGNAL_LIQUIDITY_BUILD_WEIGHT=0.10
SIGNAL_VOL_MCAP_RATIO_WEIGHT=0.09

# Win signal amplification factor
WIN_SIGNAL_AMPLIFY_FACTOR=1.15

# Loss signal dampening factor
LOSS_SIGNAL_DAMPEN_FACTOR=0.85

# ============================================================================
# RISK PER TRADE (Kelly Criterion Inspired)
# ============================================================================

# Risk per trade as % of account (conservative Kelly)
RISK_PER_TRADE_PERCENTAGE=2.0

# Maximum risk exposure across all open positions
MAX_TOTAL_EXPOSURE_PERCENTAGE=25.0

# Reduce position size if equity falls below this threshold
EQUITY_PROTECTION_LEVEL=10000

# ============================================================================
# MARKET CONDITION FILTERS
# ============================================================================

# Only trade when 24h volume > $X on Solana
MIN_MARKET_VOLUME_24H=100000000

# Skip tokens created less than X hours ago
MIN_TOKEN_AGE_HOURS=1

# Skip if token holders are too concentrated
MAX_HOLDER_CONCENTRATION=0.30

# Skip if price has moved more than X% in last hour (potential pump)
MAX_HOURLY_PRICE_MOVEMENT=50.0

# Only trade if liquidity lock is verified
REQUIRE_LIQUIDITY_LOCK=true

# ============================================================================
# EXECUTION & FILL PREFERENCES
# ============================================================================

# Maximum time to wait for transaction confirmation (seconds)
TX_CONFIRMATION_TIMEOUT=30

# Retry failed transactions up to N times
TX_RETRY_COUNT=3

# DEX routing preference (RAYDIUM, JUPITER, AUTO)
DEX_PREFERENCE=AUTO

# Split large orders across multiple transactions
ENABLE_ORDER_SPLITTING=true
SPLIT_ORDER_SIZE_THRESHOLD=10000

# ============================================================================
# REBALANCING & POSITION MANAGEMENT
# ============================================================================

# Rebalance portfolio every N hours
REBALANCE_INTERVAL_HOURS=4

# Close oldest position if max open positions reached
CLOSE_OLDEST_ON_LIMIT=true

# Average down on winning positions (add to winners)
ENABLE_AVERAGING_DOWN=false
AVERAGING_DOWN_TRIGGER_PROFIT_PERCENTAGE=10.0

# ============================================================================
# ALERTS & NOTIFICATIONS
# ============================================================================

# Alert when daily PnL reaches
ALERT_ON_DAILY_PNL_THRESHOLD=2000

# Alert on every trade execution
ALERT_ON_EVERY_TRADE=false

# Alert only on trades above X USD
ALERT_ON_TRADE_SIZE_THRESHOLD=5000

# Alert on major losses
ALERT_ON_LOSS_THRESHOLD=-1000

# ============================================================================
# EXAMPLE PRESET CONFIGURATIONS
# ============================================================================

# PRESET: NIGHT TRADER (Trades 8 hours, 9PM - 5AM, moderate aggression)
# TRADING_START_TIME=21:00
# TRADING_END_TIME=05:00
# AGGRESSION_LEVEL=MODERATE
# DAILY_PNL_TARGET=2000
# DAILY_LOSS_LIMIT=-1000
# ENABLE_TRAILING_STOP=true

# PRESET: DAYTRADER (Trades 9-5 EST, aggressive)
# TRADING_START_TIME=09:00
# TRADING_END_TIME=17:00
# TRADING_TIMEZONE=America/New_York
# AGGRESSION_LEVEL=AGGRESSIVE
# DAILY_PNL_TARGET=5000
# DAILY_LOSS_LIMIT=-2000
# TAKE_PROFIT_PERCENTAGE=15.0
# STOP_LOSS_PERCENTAGE=8.0

# PRESET: 24/7 ALPHA HUNTER (Always on, maximum aggression)
# ENABLE_24_7_TRADING=true
# AGGRESSION_LEVEL=MAXIMUM
# DAILY_PNL_TARGET=10000
# DAILY_LOSS_LIMIT=-5000
# MONTHLY_PNL_TARGET=200000
# MAX_DRAWDOWN_PERCENTAGE=20.0

# PRESET: CONSERVATIVE EARNER (Very safe, long holds, low frequency)
# ENABLE_24_7_TRADING=false
# TRADING_START_TIME=10:00
# TRADING_END_TIME=16:00
# PAUSE_ON_WEEKENDS=true
# AGGRESSION_LEVEL=CONSERVATIVE
# DAILY_PNL_TARGET=500
# DAILY_LOSS_LIMIT=-300
# HOLD_TIME_MINUTES=240
# MAX_POSITION_SIZE_USD=1000

# PRESET: WEEKEND WARRIOR (Only trades weekends, moderate-aggressive)
# TRADING_DAYS=5,6
# AGGRESSION_LEVEL=AGGRESSIVE
# ENABLE_TRAILING_STOP=true
# TRAILING_STOP_PERCENTAGE=8.0
# TAKE_PROFIT_PERCENTAGE=20.0

# ============================================================================
# DEBUGGING & TESTING
# ============================================================================

# Enable simulation mode (no real trades, just calculations)
ENABLE_SIMULATION_MODE=false

# Enable dry-run (calculate trades but don't execute)
ENABLE_DRY_RUN=false

# Log every signal calculation
LOG_ALL_SIGNALS=false

# Log all position changes
LOG_POSITION_CHANGES=true

# Backtest mode - use historical data
ENABLE_BACKTEST=false
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-01-31
